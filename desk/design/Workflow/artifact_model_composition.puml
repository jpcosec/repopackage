@startuml artifact_model_composition
skinparam monochrome true
skinparam defaultFontName "Monospace"

title Artifact Models: Pydantic Layer + Composition

' ─────────────────────────────────────────
' ZONE 1: DRAWERS (Backlog)
' ─────────────────────────────────────────
package "Zone 1: Drawers" {

    class DesignSpecModel {
        +__template__: ClassVar[str]
        --
        +name: str
        +layer_0: str
        +layer_1: str
        +layer_2: str
        +layer_3: str
        +layer_4: str
        +layer_5: str
    }

    class ModuleContractModel {
        +__template__: ClassVar[str]
        --
        +module_name: str
        +version: str
        +description: str
        +inputs: List[ContractField]
        +outputs: List[ContractField]
        +traits: List[str]
    }
}

' ─────────────────────────────────────────
' ZONE 2: DESK (Active Workspace)
' ─────────────────────────────────────────
package "Zone 2: Desk" {

    class BoardModel {
        +__template__: ClassVar[str]
        --
        +phases: List[PhaseModel]
        +pills: List[PillModel]
    }

    class PhaseModel {
        +__template__: ClassVar[str]
        --
        +id: str
        +tasks: List[TaskModel]
    }

    class TaskModel {
        +__template__: ClassVar[str]
        --
        +id: str
        +title: str
        +status: TaskStatus
        +priority: TaskPriority
        +phase: str
        +pills: List[str]
        +depends_on: List[str]
        +explanation: str
        +induced_changes: Optional[str]
        +commit_sha: Optional[str]
    }

    class PillModel {
        +__template__: ClassVar[str]
        --
        +metadata: PillMetadata
        +title: str
        +why: str
        +what: str
        +how: str
    }

    class PillMetadata {
        +id: str
        +type: str
        +scope: str
        +language: str
        +nature: str
        +status: str
    }

    ' Vertical composition
    BoardModel *-- "many" PhaseModel : owns
    BoardModel *-- "many" PillModel : owns
    PhaseModel *-- "many" TaskModel : owns

    ' Horizontal reference (Task refs Pills by ID, resolved at artifact layer)
    TaskModel ..> PillModel : refs by id

    PillModel *-- PillMetadata
}

' ─────────────────────────────────────────
' ZONE 3: RUNS (Execution)
' ─────────────────────────────────────────
package "Zone 3: Runs" {

    class EvidenceModel {
        +__template__: ClassVar[str]
        --
        +task_id: str
        +passed: bool
        +lint_ok: bool
        +tests_ok: bool
        +raw_log: str
        +commit_sha: Optional[str]
    }

    class GitCommitModel {
        +__template__: ClassVar[str]
        --
        +type: str
        +scope: str
        +description: str
        +task_id: Optional[str]
        +phase_id: Optional[str]
        +sha: Optional[str]
    }

    ' GitCommit refs Task OR Phase (not both)
    GitCommitModel ..> TaskModel : refs (task commit)
    GitCommitModel ..> PhaseModel : refs (phase commit)

    ' Evidence belongs to a Task
    EvidenceModel ..> TaskModel : belongs to
}

' ─────────────────────────────────────────
' CROSS-ZONE FLOWS
' ─────────────────────────────────────────
DesignSpecModel ..> TaskModel : promote-spec

@enduml
