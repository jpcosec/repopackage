@startuml
skinparam handwritten false
skinparam monochrome true
skinparam shadowing false

title Mapa de Comandos CLI (Estructura Jerárquica)

node "repopackage" as CLI {
    node "desk" {
        [tasks] <<atomize / list / close>>
        [pills] <<inject / audit / promote>>
    }
    node "drawers" {
        [specs] <<add / list / promote>>
    }
    node "standardize" {
        [module] <<create / check / export>>
    }
    node "exec" {
        [run] <<dispatch / monitor / rescue>>
    }
    node "eval" {
        [audit] <<lint / test / coverage>>
    }
}

note bottom of CLI
  Uso: repopackage <category> <subject> <action>
  Ejemplo: repopackage desk tasks atomize --feature auth
end note

@enduml
