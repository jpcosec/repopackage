@startuml
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle rectangle

title Adversarial Execution Diagram

package "Caged Environment" {
    actor "Agent A\n(Test Gen)" as A
    actor "Agent B\n(Implementer)" as B
    
    file "Tests" as T
    file "Code" as C
    
    A --> T : Writes behavioral tests\nbased on Blueprint
    T --> B : "Guardrail"
    B --> C : Implements logic\nto satisfy tests
    C --> T : Feedback Loop\n(Pass/Fail)
    
    note bottom of T : Agent B cannot modify tests
    note bottom of C : Agent A cannot modify code
}

@enduml
