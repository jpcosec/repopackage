@startuml
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle rectangle

title Task Compilation Diagram

node "Source of Truth (YAML)" as yaml {
    [task_template.yaml] as template
    [pill_template.yaml] as p_template
}

node "Input (Design Spec)" as input {
    [Spec.md] as spec
}

cloud "Compilation Engine\n(CLI: drawers promote-spec)" as engine

node "Executable Artifacts (Markdown)" as output {
    [T-XXX.md] as task
    [PILL-XXX.md] as pill
}

spec --> engine : 1. Parse Goal/Context
template --> engine : 2. Apply Schema
p_template --> engine : 3. Apply Schema
engine --> task : 4. Generate Task
engine --> pill : 5. Generate Pills

@enduml
