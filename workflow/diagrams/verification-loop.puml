@startuml
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle rectangle

title Verification Loop Diagram

(*) --> "Agent Logout"
--> "Rescue Raw Logs\n(capture rescue-logs)"
--> "Normalize Evidence\n(capture format-evidence)"
--> "Execution Gate\n(eval full-gate)"
if "Gate Green?" then
  -->[Yes] "Supervisor Audit\n(Trace Review)"
  if "Audit Pass?" then
    -->[Yes] "Merge Work\n(integrate merge-work)"
    --> "Task Closure"
    --> (*)
  else
    -->[No] "Failure Report"
    --> "Task Re-opened"
    --> (*)
  endif
else
  -->[No] "Failure Report"
  --> "Task Re-opened"
endif

@enduml
