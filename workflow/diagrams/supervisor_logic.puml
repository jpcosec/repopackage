@startuml
skinparam handwritten false
skinparam monochrome false
skinparam defaultFontName "Monospace"

title Lógica Estricta del Supervisor: Protocolo de Entrada y Control

start
:Recibir Feature Spec / Issue;

partition "Evaluación de la Base de Código" {
    :Analizar código relacionado;
    if (¿El código es legible y atomizado?) then (No)
        #Pink:FASE DE ATOMIZACIÓN PREVIA;
        :Trocear archivos (>80 líneas);
        :Trocear funciones (>10 líneas);
        :Asegurar SRP (Responsabilidad Única);
        :Commit de limpieza/preparación;
    else (Sí)
        :Confirmar Estado Saludable;
    endif
}

partition "Diseño de la Intervención" {
    :Identificar Átomos de Cambio;
    :Crear Píldoras de Contexto (Target);
    if (¿Hay trampas de lógica o deuda técnica?) then (Sí)
        :Crear Píldora de Contexto (Current);
    endif
    :Redactar Tareas (.md);
    :Definir Grafo de Dependencias;
}

partition "Ritual de Indexación" {
    :Generar Fases de Ejecución;
    :Actualizar Board.md;
    note right: Solo tareas listas para\nejecución pasan a 'Active'
}

:Despachar Ejecutores;

partition "Validación y Gatekeeping" {
    while (¿Tareas completadas en fase?) is (Sí)
        :Verificar Commit único por tarea;
        :Validar 'Induced Changes' en el .md;
        :Confirmar Unit Tests exitosos;
        if (¿Cumple estándares?) then (Sí)
            :Cerrar Tarea;
        else (No)
            #Orange:Rechazar y re-asignar;
        endif
    endwhile (No)
}

if (¿Feature Completa?) then (Sí)
    #LightGreen:EJECUTAR FEATURE CLEANUP;
    stop
else (No)
    :Siguiente Fase;
    goto partition "Ritual de Indexación"
endif

@enduml
